{
  "expo": {
    "name": "Nexus Frota",
    "slug": "vetra-motorista",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0E14",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.vetrafrotas.motorista"
    },
    "android": {
      "package": "br.com.vetrafrotas.motorista",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A0E14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "O Nexus Frota usa sua localização para acompanhar a viagem em andamento, inclusive com a tela bloqueada.",
          "locationAlwaysPermission": "O Nexus Frota usa sua localização para acompanhar a viagem em andamento, inclusive com a tela bloqueada.",
          "locationWhenInUsePermission": "O Nexus Frota usa sua localização para acompanhar a viagem em andamento."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9a85ddf9-8247-4d48-a66b-dd6fe1187930"
      }
    },
    "owner": "nexus-orbital"
  }
}
